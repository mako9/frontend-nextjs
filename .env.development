# Committed development defaults. .gitignore excludes .env.local and .env.*.local, not this file, so
# anything here is public by definition: it is the local stack in backend-quarkus/docker/compose.dev.yml
# and the realm in backend-quarkus/config/quarkus-realm.json, whose values are already in that file.
# Put personal overrides in .env.local, which wins over this file.

# API the browser and the server render talk to
BACKEND_BASE_URL=http://127.0.0.1:8080/api

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development-only-never-use-this-value

# Keycloak dev services / compose.dev.yml realm
KEYCLOAK_ISSUER=http://localhost:8180/realms/quarkus
KEYCLOAK_CLIENT_ID=backend-service
KEYCLOAK_CLIENT_SECRET=secret

LOG_LEVEL=debug
