# Copy to .env.local for development, or set these in the deployment environment.
# Every value below is a placeholder. Never commit a real secret: .env.local is gitignored, this file is not.

# Where the API lives. Read server-side at runtime AND inlined into the browser bundle at build time
# (next.config.js passes it through `env`), so changing it for a deployment means rebuilding, not just
# restarting. Required: without it the client bundle builds "undefined/user/..." URLs.
BACKEND_BASE_URL=https://api.example.org/api

# The origin users reach this app on. next-auth builds its callback URL from it.
NEXTAUTH_URL=https://app.example.org

# Random string that signs the next-auth session cookie. Generate one per deployment, e.g.
# `openssl rand -base64 32`.
NEXTAUTH_SECRET=generate-a-per-deployment-value

# Keycloak realm and client. The issuer must be the URL the tokens are issued under, or OIDC rejects them.
KEYCLOAK_ISSUER=https://auth.example.org/realms/quarkus
KEYCLOAK_CLIENT_ID=backend-service
# The web client is a public client in the pilot's realm: give this a value only if the realm marks
# backend-service confidential. Never reuse the backend's own client secret here.
KEYCLOAK_CLIENT_SECRET=the-realm-client-secret

# info | debug | warn | error
LOG_LEVEL=info
